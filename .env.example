# Intervalo de sincronización automática cuando hay ventas recientes (minutos)
ACTIVE_SYNC_INTERVAL_MINUTES=10

# Intervalo cuando no hay ventas recientes (minutos, ej. 120 = 2 horas)
IDLE_SYNC_INTERVAL_MINUTES=120

# Puerto del servidor local
PORT=8000

# URLs de ventas / login
LUMEPIC_LOGIN_URL=https://photographer.lumepic.com/es/sales
LUMEPIC_DASHBOARD_URL=https://photographer.lumepic.com/es/sales
MOMENTIA_LOGIN_URL=https://moment-ia.shop/photographer/dashboard?section=sales
MOMENTIA_DASHBOARD_URL=https://moment-ia.shop/photographer/dashboard?section=sales

# Iniciar con datos de demostración si la base de datos está vacía (true/false)
SEED_DEMO_ON_EMPTY=true

# Opcional: Turso (libSQL) para persistencia en la nube (Render)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Opcional: contraseña para proteger el tablero cuando está publicado en internet
APP_PASSWORD=
